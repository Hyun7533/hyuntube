"source":"33","usedDeprecatedRules":"18"},"/Users/kimtaehyun/react-workspace/youtube/src/index.js",[],["34","35"],"/Users/kimtaehyun/react-workspace/youtube/src/reportWebVitals.js",[],"/Users/kimtaehyun/react-workspace/youtube/src/components/video_list/video_list.jsx",["36"],"import React from 'react';\nimport Video_item from '../video_item/video_item';\nimport styles from './video_list.module.css'\n\nconst Video_list = ({ videos, onVideoClick, display }) => (\n    <ul className={styles.videos}>\n        {\n            videos.map(video =>\n                <Video_item\n                    key={video.id}\n                    video={video}\n                    onVideoClick={onVideoClick}\n                    display={display} />)\n        }\n    </ul>\n);\n\nexport default Video_list;","/Users/kimtaehyun/react-workspace/youtube/src/components/video_item/video_item.jsx",[],"/Users/kimtaehyun/react-workspace/youtube/src/components/search_header/search_header.jsx",[],"/Users/kimtaehyun/react-workspace/youtube/src/components/video_detail/video_detail.jsx",["37"],"import React from 'react';\nimport styles from './video_detail.module.css'\n\nconst Video_detail = ({ video: { id }, video: { snippet } }) => {\n\n    return (\n        <section className={styles.detail}>\n            <iframe\n                className={styles.video}\n                type=\"text/html\"\n                width=\"1500px\"\n                height=\"900px\"\n                src={`https://www.youtube.com/embed/${id.videoId}`}\n                frameborder=\"0\"\n                allowFullScreen\n            ></iframe>\n            <h2>{snippet.title}</h2>\n            <h3>{snippet.channelTitle}</h3>\n            <pre className={styles.description}>{snippet.description}</pre>\n        </section>\n    );\n}\n\nexport default Video_detail;","/Users/kimtaehyun/react-workspace/youtube/src/App.jsx",["38","39","40"],"import styles from './app.module.css'\nimport { useEffect, useState } from 'react';\nimport Video_list from './components/video_list/video_list';\nimport Search_header from './components/search_header/search_header';\nimport Video_detail from './components/video_detail/video_detail';\n\nfunction App() {\n  const [videos, setVideos] = useState([]);\n  const [selectedVideo, setSelectedVideo] = useState(null);\n\n  const selectVideo = (video) => {\n    setSelectedVideo(video)\n  }\n\n  const search = (query) => { // 검색할때 실행되는 함수\n    const requestOptions = {\n      method: 'GET',\n      redirect: 'follow'\n    };\n\n    fetch(`https://www.googleapis.com/youtube/v3/search?part=snippet&maxResults=50&q=${query}&key=AIzaSyALd5gN0lZ5gFbk7dys3373SqkmhNcF_dE`,\n      requestOptions)\n      .then(response => response.json())\n      .then(result => setVideos(result.items))\n      .catch(error => console.log('error', error));\n  };\n\n  useEffect(() => {\n\n    const requestOptions = {\n      method: 'GET',\n      redirect: 'follow'\n    };\n\n    fetch(\"https://youtube.googleapis.com/youtube/v3/search?part=snippet&maxResults=50&q=youtube&key=AIzaSyALd5gN0lZ5gFbk7dys3373SqkmhNcF_dE\", requestOptions)\n      .then(response => response.json())\n      .then(result => setVideos(result.items))\n      .then(console.log('basic fetch api'))\n      .catch(error => console.log('error', error));\n  }, []) // []없으면 계속 fetch api를 얻어온다 필요할때만 업데이트 한다 (Component update)\n\n  return <>\n    <Search_header onSearch={search} />\n    < section className={styles.content}>\n      {selectedVideo && (<div className={styles.detail}>\n        <Video_detail video={selectedVideo} />\n      </div>)}\n      <div className={styles.list}>\n        <Video_list videos={videos} onVideoClick={selectVideo} display={selectedVideo ? 'list' : 'grid'}></Video_list>\n      </div>\n    </section>\n  </>\n}\n\nexport default App;",{"ruleId":"41","replacedBy":"42"},{"ruleId":"43","replacedBy":"44"},{"ruleId":"45","severity":1,"message":"46","line":9,"column":17,"nodeType":"47","endLine":13,"endColumn":41},{"ruleId":"48","severity":1,"message":"49","line":8,"column":13,"nodeType":"47","endLine":16,"endColumn":14},{"ruleId":"45","severity":1,"message":"50","line":43,"column":5,"nodeType":"47","endLine":43,"endColumn":40},{"ruleId":"45","severity":1,"message":"51","line":46,"column":9,"nodeType":"47","endLine":46,"endColumn":47},{"ruleId":"45","severity":1,"message":"52","line":49,"column":9,"nodeType":"47","endLine":49,"endColumn":106},"no-native-reassign",["53"],"no-negated-in-lhs",["54"],"react/jsx-pascal-case","Imported JSX component Video_item must be in PascalCase or SCREAMING_SNAKE_CASE","JSXOpeningElement","jsx-a11y/iframe-has-title","<iframe> elements must have a unique title property.","Imported JSX component Search_header must be in PascalCase or SCREAMING_SNAKE_CASE","Imported JSX component Video_detail must be in PascalCase or SCREAMING_SNAKE_CASE","Imported JSX component Video_list must be in PascalCase or SCREAMING_SNAKE_CASE","no-global-assign","no-unsafe-negation"]